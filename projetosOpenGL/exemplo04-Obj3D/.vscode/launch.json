{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug com CMake",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            //"program": "${workspaceFolder}/Projeto_OpenGL.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            //"cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar formatação para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "gdb.exe",  // ou caminho completo, se necessário
            "preLaunchTask": "CMake: build"
        }
    ]
}