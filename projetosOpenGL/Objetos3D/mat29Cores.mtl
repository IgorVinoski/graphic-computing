# Materiais do OpenGL, converti para .MTL
# ===================== PARÂMETROS DO ARQUIVO .MTL =====================
# Ns  - Brilho (shininess)
#       0   = reflexão espalhada e fosca
#       1000 = reflexão muito concentrada e brilhante
#
# Ka  - Cor ambiente (ambient reflectivity)
# Kd  - Cor difusa (diffuse reflectivity)
# Ks  - Cor especular (specular reflectivity)
#
# Ke  - Emissão (emissive color)
#       Faz o objeto parecer autoiluminado.
#       Valor padrão: Ke 0.000 0.000 0.000
#       No fragment shader: vec3 cor = ambient + diffuse + specular + material.emissive;
#
# Ni  - Índice de refração (optical density)
#       Exemplos:
#         Ar:    1.0
#         Água:  1.33
#         Vidro: ~1.5
#
# d   - Transparência (dissolve)
#       1.0 = totalmente opaco
#       0.0 = totalmente transparente
#
# illum - Modelo de iluminação:
#       0 = Só cor difusa, sem luz ambiente
#       1 = Difusa + ambiente
#       2 = Difusa + ambiente + especular
#       3 = Com reflexão (ray tracing)
#       7 = Transparência + reflexão
# ======================================================================

newmtl matCorLatao
Ka 0.329412 0.223529 0.027451
Kd 0.780392 0.568627 0.113725
Ks 0.992157 0.941176 0.807843
Ns 27.897400
Ke 0.000000 0.000000 0.000000
Ni 1.5
d 1.0
illum 2

